              "code": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>My CSS Portfolio</title>\n  <style>\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n\n    body {\n      font-family: sans-serif;\n      line-height: 1.6;\n      color: #1e293b;\n      background-color: #f8fafc;\n    }\n    a { text-decoration: none; }\n    h1 { font-size: 2.75rem; }\n    h2 { font-size: 1.75rem; }\n    h3 { font-size: 1.25rem; }\n    p { color: #475569; }\n\n    .nav {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      background-color: #0f172a;\n      padding: 16px 24px;\n    }\n    .nav-logo {\n      color: white;\n      font-weight: bold;\n      font-size: 1.25rem;\n    }\n    .nav-links {\n      display: flex;\n      gap: 24px;\n    }\n    .nav-links a { color: white; }\n    .nav-links a:hover { color: #10B981; }\n\n    .hero {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      text-align: center;\n      background-color: #1e293b;\n      padding: 96px 24px;\n    }\n    .hero h1 {\n      color: white;\n      margin-bottom: 12px;\n    }\n    .hero p {\n      color: #cbd5e1;\n      margin-bottom: 28px;\n    }\n    .btn {\n      display: inline-block;\n      background-color: #10B981;\n      color: white;\n      font-weight: bold;\n      padding: 12px 28px;\n      border-radius: 8px;\n    }\n    .btn:hover { background-color: #059669; }\n\n    .skills-section {\n      max-width: 960px;\n      margin: 0 auto;\n      padding: 64px 24px;\n      text-align: center;\n    }\n    .skills-section h2 { margin-bottom: 32px; }\n    .skills-grid {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 24px;\n    }\n    .skill-card {\n      flex: 1 1 200px;\n      background-color: white;\n      padding: 24px;\n      border-radius: 12px;\n      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);\n    }\n    .skill-card h3 { margin-bottom: 8px; }\n\n    .footer {\n      background-color: #0f172a;\n      padding: 24px;\n      text-align: center;\n    }\n    .footer p { color: #94a3b8; }\n  </style>\n</head>\n<body>\n  <nav class=\"nav\">\n    <span class=\"nav-logo\">MyPortfolio</span>\n    <div class=\"nav-links\">\n      <a href=\"#skills\">Skills</a>\n      <a href=\"#contact\">Contact</a>\n    </div>\n  </nav>\n\n  <section class=\"hero\">\n    <h1>Hello, I am Learning CSS!</h1>\n    <p>Week 3 · CSS Introduction · Gachon University</p>\n    <a href=\"#skills\" class=\"btn\">See My Skills</a>\n  </section>\n\n  <section class=\"skills-section\" id=\"skills\">\n    <h2>What I Know</h2>\n    <div class=\"skills-grid\">\n      <div class=\"skill-card\"><h3>HTML5</h3><p>Structure and semantics</p></div>\n      <div class=\"skill-card\"><h3>CSS3</h3><p>Styling and layout</p></div>\n      <div class=\"skill-card\"><h3>Flexbox</h3><p>Modern layout model</p></div>\n    </div>\n  </section>\n\n  <footer class=\"footer\" id=\"contact\">\n    <p>K0126002 Web Programming &copy; 2026 Gachon University</p>\n  </footer>\n</body>\n</html>"
