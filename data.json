    {
      "id": "ae1qql12",
      "title": "Week 9",
      "tasks": [
        {
          "id": "10inpok3",
          "text": "Task 1",
          "done": false,
          "files": [
            {
              "id": "w93c3u1o",
              "name": "sample.html",
              "code": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <meta name=\"color-scheme\" content=\"light dark\">\n  <title>Creative Coding Lab | Week 9</title>\n  <link rel=\"stylesheet\" href=\"../style.css\">\n</head>\n<body>\n  <main class=\"form-page\">\n    <a class=\"back\" href=\"../index.html\">Back to Week 9</a>\n    <section class=\"form-layout\" id=\"formContainer\" aria-label=\"Creative Coding Lab registration\">\n      <aside class=\"form-aside\">\n        <div class=\"aside-content\">\n          <p class=\"aside-kicker\">Creative Coding Lab · Spring session</p>\n          <h2>Bring your next idea to life.</h2>\n          <p class=\"aside-copy\">Join a hands-on community exploring the playful side of the web. Pick a track and save your seat.</p>\n        </div>\n        <div class=\"aside-bottom\"><span class=\"aside-dots\" aria-hidden=\"true\"><span></span><span></span><span></span></span> Learn by making · Share what you find</div>\n      </aside>\n      <div class=\"form-main\">\n        <p class=\"eyebrow\">Save your spot</p>\n        <h1>Lab registration</h1>\n        <p class=\"form-intro\">A few quick details. We’ll let you know if anything needs a second look.</p>\n        <form id=\"regForm\" novalidate>\n          <fieldset class=\"form-section\">\n            <legend>Your details</legend>\n            <div class=\"field-row\">\n              <div class=\"field\">\n                <label for=\"studentId\">Campus ID <span class=\"field-hint\">(9 digits)</span></label>\n                <input type=\"text\" id=\"studentId\" name=\"studentId\" inputmode=\"numeric\" autocomplete=\"off\" placeholder=\"e.g. 202612345\" aria-describedby=\"idError\" aria-invalid=\"false\">\n                <p id=\"idError\" class=\"error-msg\" aria-live=\"polite\"></p>\n              </div>\n              <div class=\"field\">\n                <label for=\"fullName\">Your name</label>\n                <input type=\"text\" id=\"fullName\" name=\"fullName\" autocomplete=\"name\" placeholder=\"First and last name\" aria-describedby=\"nameError\" aria-invalid=\"false\">\n                <p id=\"nameError\" class=\"error-msg\" aria-live=\"polite\"></p>\n              </div>\n            </div>\n            <div class=\"field\">\n              <label for=\"track\">Choose a lab track</label>\n              <select id=\"track\" name=\"track\" aria-describedby=\"trackError\" aria-invalid=\"false\">\n                <option value=\"\">Select a track</option>\n                <option value=\"Creative Web Design\">Creative Web Design</option>\n                <option value=\"Generative Art\">Generative Art</option>\n                <option value=\"Interactive Experiences\">Interactive Experiences</option>\n                <option value=\"Digital Prototyping\">Digital Prototyping</option>\n              </select>\n              <p id=\"trackError\" class=\"error-msg\" aria-live=\"polite\"></p>\n            </div>\n          </fieldset>\n\n          <fieldset class=\"form-section\">\n            <legend>Set up your account</legend>\n            <div class=\"field\">\n              <label for=\"email\">Email address</label>\n              <input type=\"email\" id=\"email\" name=\"email\" autocomplete=\"email\" placeholder=\"you@example.edu\" aria-describedby=\"emailError\" aria-invalid=\"false\">\n              <p id=\"emailError\" class=\"error-msg\" aria-live=\"polite\"></p>\n            </div>\n            <div class=\"field-row\">\n              <div class=\"field\">\n                <label for=\"password\">Create a password</label>\n                <input type=\"password\" id=\"password\" name=\"password\" autocomplete=\"new-password\" placeholder=\"At least 8 characters\" aria-describedby=\"passwordError\" aria-invalid=\"false\">\n                <p id=\"passwordError\" class=\"error-msg\" aria-live=\"polite\"></p>\n              </div>\n              <div class=\"field\">\n                <label for=\"confirmPassword\">Confirm password</label>\n                <input type=\"password\" id=\"confirmPassword\" name=\"confirmPassword\" autocomplete=\"new-password\" placeholder=\"Type it once more\" aria-describedby=\"confirmError\" aria-invalid=\"false\">\n                <p id=\"confirmError\" class=\"error-msg\" aria-live=\"polite\"></p>\n              </div>\n            </div>\n          </fieldset>\n\n          <div class=\"checkbox-wrap\">\n            <input type=\"checkbox\" id=\"agreeTerms\" name=\"agreeTerms\" aria-describedby=\"termsError\" aria-invalid=\"false\">\n            <label for=\"agreeTerms\">I agree to the Creative Coding Lab participation guidelines.</label>\n          </div>\n          <p id=\"termsError\" class=\"error-msg terms-error\" aria-live=\"polite\"></p>\n\n          <button type=\"submit\" class=\"submit-button\">Reserve my spot <span aria-hidden=\"true\">→</span></button>\n          <p class=\"form-footnote\">Demo only. Details stay in this browser; your password is never shown.</p>\n        </form>\n      </div>\n    </section>\n\n    <section id=\"successCard\" class=\"success-card\" aria-labelledby=\"successHeading\" tabindex=\"-1\" hidden>\n      <div class=\"success-mark\" aria-hidden=\"true\">✓</div>\n      <p class=\"eyebrow\">You’re on the list</p>\n      <h1 id=\"successHeading\">Your next idea starts here.</h1>\n      <p>Your demo registration is complete. Here’s a quick look at your details.</p>\n      <dl id=\"summaryDetails\" class=\"summary-box\"></dl>\n      <button type=\"button\" class=\"reset-button\" id=\"resetButton\">Register another maker</button>\n    </section>\n  </main>\n  <script>\n    const form = document.getElementById('regForm');\n    const idInput = document.getElementById('studentId');\n    const nameInput = document.getElementById('fullName');\n    const trackInput = document.getElementById('track');\n    const emailInput = document.getElementById('email');\n    const passwordInput = document.getElementById('password');\n    const confirmInput = document.getElementById('confirmPassword');\n    const termsInput = document.getElementById('agreeTerms');\n    const formContainer = document.getElementById('formContainer');\n    const successCard = document.getElementById('successCard');\n    const summaryDetails = document.getElementById('summaryDetails');\n    const touchedFields = new Set();\n\n    function markValid(input, errorId) {\n      input.classList.remove('is-invalid');\n      input.classList.add('is-valid');\n      input.setAttribute('aria-invalid', 'false');\n      document.getElementById(errorId).textContent = '';\n      return true;\n    }\n\n    function markInvalid(input, errorId, message) {\n      input.classList.remove('is-valid');\n      input.classList.add('is-invalid');\n      input.setAttribute('aria-invalid', 'true');\n      document.getElementById(errorId).textContent = message;\n      return false;\n    }\n\n    function checkId() {\n      const value = idInput.value.trim();\n      if (!value) return markInvalid(idInput, 'idError', 'Enter your campus ID.');\n      if (!/^\\d{9}$/.test(value)) return markInvalid(idInput, 'idError', 'Your campus ID must be exactly 9 digits.');\n      return markValid(idInput, 'idError');\n    }\n\n    function checkName() {\n      const value = nameInput.value.trim();\n      if (!value) return markInvalid(nameInput, 'nameError', 'Tell us your name.');\n      if (value.length < 2) return markInvalid(nameInput, 'nameError', 'Your name must be at least 2 characters.');\n      return markValid(nameInput, 'nameError');\n    }\n\n    function checkTrack() {\n      if (!trackInput.value) return markInvalid(trackInput, 'trackError', 'Choose the lab track you’re interested in.');\n      return markValid(trackInput, 'trackError');\n    }\n\n    function checkEmail() {\n      const value = emailInput.value.trim();\n      if (!value) return markInvalid(emailInput, 'emailError', 'Enter your email address.');\n      if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(value)) {\n        return markInvalid(emailInput, 'emailError', 'Enter a valid email address, like you@example.edu.');\n      }\n      return markValid(emailInput, 'emailError');\n    }\n\n    function checkPassword() {\n      if (!passwordInput.value) return markInvalid(passwordInput, 'passwordError', 'Create a password to continue.');\n      if (passwordInput.value.length < 8) {\n        return markInvalid(passwordInput, 'passwordError', 'Use at least 8 characters for your password.');\n      }\n      markValid(passwordInput, 'passwordError');\n      if (touchedFields.has(confirmInput)) checkConfirm();\n      return true;\n    }\n\n    function checkConfirm() {\n      if (!confirmInput.value) return markInvalid(confirmInput, 'confirmError', 'Type your password one more time.');\n      if (confirmInput.value !== passwordInput.value) {\n        return markInvalid(confirmInput, 'confirmError', 'These passwords don’t match yet.');\n      }\n      return markValid(confirmInput, 'confirmError');\n    }\n\n    function checkTerms() {\n      const error = document.getElementById('termsError');\n      if (!termsInput.checked) {\n        termsInput.setAttribute('aria-invalid', 'true');\n        error.textContent = 'Please agree to the participation guidelines to register.';\n        return false;\n      }\n      termsInput.setAttribute('aria-invalid', 'false');\n      error.textContent = '';\n      return true;\n    }\n\n    const fieldChecks = new Map([\n      [idInput, checkId],\n      [nameInput, checkName],\n      [trackInput, checkTrack],\n      [emailInput, checkEmail],\n      [passwordInput, checkPassword],\n      [confirmInput, checkConfirm]\n    ]);\n\n    for (const [input, check] of fieldChecks) {\n      input.addEventListener('blur', () => {\n        touchedFields.add(input);\n        check();\n      });\n      input.addEventListener(input === trackInput ? 'change' : 'input', () => {\n        if (touchedFields.has(input)) check();\n      });\n    }\n\n    termsInput.addEventListener('change', checkTerms);\n\n    form.addEventListener('submit', (event) => {\n      event.preventDefault();\n      for (const input of fieldChecks.keys()) touchedFields.add(input);\n\n      const checks = [...fieldChecks.values()].map((check) => check());\n      const termsValid = checkTerms();\n      const valid = checks.every(Boolean) && termsValid;\n      if (!valid) {\n        const firstInvalid = form.querySelector('[aria-invalid=\"true\"]');\n        firstInvalid?.focus();\n        return;\n      }\n\n      const details = [\n        ['Campus ID', idInput.value.trim()],\n        ['Name', nameInput.value.trim()],\n        ['Lab track', trackInput.value],\n        ['Email', emailInput.value.trim()]\n      ];\n      summaryDetails.replaceChildren(...details.map(([label, value]) => {\n        const row = document.createElement('div');\n        row.className = 'summary-row';\n        const term = document.createElement('dt');\n        term.textContent = label;\n        const description = document.createElement('dd');\n        description.textContent = value;\n        row.append(term, description);\n        return row;\n      }));\n\n      formContainer.hidden = true;\n      successCard.hidden = false;\n      successCard.focus();\n    });\n\n    document.getElementById('resetButton').addEventListener('click', () => {\n      form.reset();\n      touchedFields.clear();\n      for (const input of [...fieldChecks.keys(), termsInput]) {\n        input.classList.remove('is-valid', 'is-invalid');\n        input.setAttribute('aria-invalid', 'false');\n      }\n      for (const error of form.querySelectorAll('.error-msg')) error.textContent = '';\n      summaryDetails.replaceChildren();\n      successCard.hidden = true;\n      formContainer.hidden = false;\n      idInput.focus();\n    });\n  </script>\n</body>\n</html>"
            }
          ]
        }
      ]
    }
  ]
}