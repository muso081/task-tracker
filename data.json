              "code": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <meta name=\"theme-color\" content=\"#10120f\">\n  <meta name=\"description\" content=\"Xushnudbek's Week 10 coursework: Git, GitHub, version control, and deployment.\">\n  <title>Week 10 — Ship it | Xushnudbek</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n  <a class=\"skip-link\" href=\"#main-content\">Skip to content</a>\n  <div class=\"page-shell\">\n    <header class=\"topbar\">\n      <a class=\"brand\" href=\"../index.html\" aria-label=\"Coursework home\">\n        <span class=\"brand-mark\" aria-hidden=\"true\">X.</span>\n        <span>WEEK<span class=\"brand-light\">NOTES</span></span>\n      </a>\n      <nav class=\"top-nav\" aria-label=\"Page navigation\">\n        <a href=\"../index.html\">All weeks</a>\n        <a href=\"#work\">The work</a>\n        <a href=\"#practice\">Practice</a>\n      </nav>\n      <span class=\"week-pill\"><span aria-hidden=\"true\"></span> WEEK 10</span>\n    </header>\n    \n    <main id=\"main-content\">\n      <section class=\"hero\" aria-labelledby=\"page-title\">\n        <div class=\"hero-copy\">\n          <p class=\"eyebrow\"><span class=\"eyebrow-line\"></span> WEB PROGRAMMING <span class=\"eyebrow-slash\">/</span> GIT, GITHUB &amp; PAGES</p>\n          <h1 id=\"page-title\">Build it.<br><span>Track it.</span><br>Ship it.</h1>\n          <p class=\"hero-intro\">A week of version control and deployment: small commits, useful branches, pull requests, and a site that makes it to the web.</p>\n          <div class=\"hero-actions\">\n            <a class=\"button button-lime\" href=\"#work\">Explore Week 10 <span aria-hidden=\"true\">↓</span></a>\n            <a class=\"text-link\" href=\"https://insurance-ai.tech\" target=\"_blank\" rel=\"noopener noreferrer\">Visit my project <span aria-hidden=\"true\">↗</span><span class=\"visually-hidden\"> (open in new tab)</span></a>\n          </div>\n          <div class=\"student-line\">\n            <span class=\"avatar\" aria-hidden=\"true\">X</span>\n            <span><strong>Xushnudbek</strong><small>WEB PROGRAMMING · WEEK 10</small></span>\n          </div>\n        </div>\n        <div class=\"hero-visual\" aria-label=\"A visual illustration of a project moving from code to a live website\">\n          <div class=\"visual-top\"><span>DEPLOYMENT FLOW</span><span class=\"visual-dots\" aria-hidden=\"true\">● ● ●</span></div>\n          <div class=\"flow\">\n            <div class=\"flow-node node-code\"><span class=\"node-icon\" aria-hidden=\"true\">&lt;/&gt;</span><span>CODE</span></div>\n            <span class=\"flow-arrow\" aria-hidden=\"true\">↘</span>\n            <div class=\"flow-node node-branch\"><span class=\"node-icon\" aria-hidden=\"true\">⑂</span><span>BRANCH</span></div>\n            <span class=\"flow-arrow\" aria-hidden=\"true\">↗</span>\n            <div class=\"flow-node node-live\"><span class=\"node-icon\" aria-hidden=\"true\">↗</span><span>LIVE</span></div>\n          </div>\n          <div class=\"terminal\">\n            <div class=\"terminal-head\"><span class=\"terminal-dot\"></span> terminal <span>~/my-project</span></div>\n            <code><span>$</span> git status<br><span class=\"terminal-green\">On branch main</span><br><span>$</span> git push origin main<br><span class=\"terminal-lime\">✓ Deployed to the web</span></code>\n          </div>\n          <span class=\"visual-stamp\" aria-hidden=\"true\">PUSH<br>TO<br>LIVE <b>↗</b></span>\n        </div>\n        <span class=\"hero-index\" aria-hidden=\"true\">10<span> / 10</span></span>\n      </section>\n\n      <section class=\"project-banner\" aria-labelledby=\"project-title\">\n        <div class=\"project-symbol\" aria-hidden=\"true\">✳</div>\n        <div class=\"project-copy\">\n          <p class=\"eyebrow\">MY PROJECT</p>\n          <h2 id=\"project-title\">Insurance, made smarter.</h2>\n          <p>Explore my project and see what I’m building.</p>\n        </div>\n        <a class=\"project-link\" href=\"https://insurance-ai.tech\" target=\"_blank\" rel=\"noopener noreferrer\">insurance-ai.tech <span aria-hidden=\"true\">↗</span><span class=\"visually-hidden\"> (open in a new tab)</span></a>\n      </section>\n    </main>\n  </div>\n</body>\n</html>\n"\n            }\n          ]\n        }\n      ]\n    }\n  ]\n}\n